# ==============================================================================
# Elcho's Pizza Enterprise Suite — Конфигурация окружения (.env.example)
# ==============================================================================

# --- Сетевые параметры сервера ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
AUTO_OPEN_BROWSER=false

# --- Параметры базы данных SQLite (WAL Mode) ---
DATABASE_FILE=pizza.db
DATABASE_JOURNAL_MODE=WAL
DATABASE_SYNCHRONOUS=NORMAL

# --- Реквизиты организации (54-ФЗ и фискальные чеки) ---
PIZZERIA_NAME="Elcho's Pizza"
ORGANIZATION_NAME="ООО «Элчос Пицца»"
ORGANIZATION_INN="7701234567"
ORGANIZATION_ADDRESS="443086, г. Самара, ул. Ново-Садовая, д. 106"
VAT_RATE=20

# --- Безопасность и сессии ---
JWT_SECRET="elchos-pizza-super-secure-production-key-2026-xyz"
SESSION_TIMEOUT_MINUTES=480
CORS_ALLOWED_ORIGINS="*"

# --- Логирование и аудит ---
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
